# Copy to .env and fill in your own keys.
# .env is gitignored.

# Local LM Studio endpoint (used by scripts/bench2.py).
# Override to point at a remote machine running LM Studio:
#   LMSTUDIO_URL=http://192.168.1.100:1234/v1
LMSTUDIO_URL=http://127.0.0.1:1234/v1

# Optional: only needed if you want to compare against OpenAI models.
OPENAI_API_KEY=

# Optional: only needed if you want to compare against Gemini models.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview:high
